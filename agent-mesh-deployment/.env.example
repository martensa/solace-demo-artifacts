# Keycloak admin (used by setup-keycloak-client.sh)
KEYCLOAK_URL=https://auth.solace.lab
KEYCLOAK_REALM=solace-lab
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Keycloak OIDC client (populated by setup-keycloak-client.sh)
KEYCLOAK_CLIENT_ID=solace-agent-mesh
KEYCLOAK_CLIENT_SECRET=changeme
KEYCLOAK_ISSUER=https://auth.solace.lab/realms/solace-lab

# LLM service
LLM_SERVICE_API_KEY=changeme

# Google AI Studio (Gemini API) key for the "google gemini" model
# alias (scripts/models/models/google-gemini.yaml). It bypasses the
# LiteLLM proxy, whose gemini-* routes are broken.
GOOGLE_AI_STUDIO_API_KEY=changeme

# SAM v2 offline artifacts (local paths, not checked in).
# SAM_CHART_PATH: unpacked Helm chart directory (contains Chart.yaml).
# SAM_*_IMAGE_TAR: offline image tarballs for scripts/load-images.sh.
# NOTE: this file is SOURCED by the scripts, so any path containing a
# space must be quoted -- e.g.
#   SAM_APP_IMAGE_TAR="/Users/me/Downloads/SAM Enterprise Update/..."
# Unquoted, the shell splits it and the variable ends up empty.
# scripts/upgrade-preflight.sh prints these lines already quoted.
# The app and str components are versioned independently; the tags
# actually deployed are pinned in local-k8s-values.yaml, and
# scripts/upgrade-preflight.sh prints the versions a new chart
# expects.
SAM_CHART_PATH=/path/to/solace-agent-mesh
SAM_APP_IMAGE_TAR=/path/to/solace-agent-mesh-<app-version>-app-arm64.tar.gz
SAM_STR_IMAGE_TAR=/path/to/solace-agent-mesh-<str-version>-str-arm64.tar.gz

# sam CLI (used by scripts/provision.sh and the scripts it runs,
# scripts/upgrade-preflight.sh and the demo install/uninstall
# scripts): either an extracted binary (SAM_CLI_PATH) or the
# delivery-package tarball (SAM_CLI_TAR, auto-extracted to
# scripts/lib/.cache/). SAM_CLI_PATH wins over the PATH, so keep
# it on the CURRENT version. Not every package ships a CLI
# tarball (2.348.22 does not) -- then drop SAM_CLI_TAR rather than
# leaving the previous version's tarball here.
SAM_CLI_PATH=/path/to/sam
SAM_CLI_TAR=/path/to/solace-agent-mesh-<app-version>-cli-darwin-arm64.tar.gz

# Demo DB credentials for the demo core connectors
# (../sam-retail-ops-demo/core/, ../sam-manufacturing-ops-demo/core/;
# optional -- the manifests default to postgres/postgres. The demo
# install scripts source this .env, so overrides set here apply).
#RETAIL_DB_USERNAME=postgres
#RETAIL_DB_PASSWORD=postgres
#MFG_DB_USERNAME=postgres
#MFG_DB_PASSWORD=postgres
