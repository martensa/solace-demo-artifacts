# Helm release and namespace
SAM_NAMESPACE=sam-ent-k8s
SAM_RELEASE=agent-mesh

# Session secret (generate a random string for production)
SAM_SESSION_SECRET_KEY=s6iRVUVvTsAkXCcWyedhFE6d4wLCw0ZA

# Keycloak admin (used by setup-keycloak-client.sh)
KEYCLOAK_URL=https://auth.solace.lab
KEYCLOAK_REALM=solace-lab
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Keycloak OIDC client (populated by setup-keycloak-client.sh)
KEYCLOAK_CLIENT_ID=solace-agent-mesh
KEYCLOAK_CLIENT_SECRET=changeme
KEYCLOAK_REDIRECT_URI=https://sam.solace.lab/callback
KEYCLOAK_ISSUER=https://auth.solace.lab/realms/solace-lab

# SAM DNS name
SAM_DNS_NAME=sam.solace.lab

# LLM service
LLM_SERVICE_API_KEY=changeme

# Docker registry pull secret (pre-existing in the namespace)
REGISTRY_PULL_SECRET=registry-pull-secret
