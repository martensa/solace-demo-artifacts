# Keycloak admin (used by setup-keycloak-client.sh)
KEYCLOAK_URL=https://auth.solace.lab
KEYCLOAK_REALM=solace-lab
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Keycloak OIDC client (populated by setup-keycloak-client.sh)
KEYCLOAK_CLIENT_ID=solace-agent-mesh
KEYCLOAK_CLIENT_SECRET=changeme
KEYCLOAK_ISSUER=https://auth.solace.lab/realms/solace-lab

# LLM service
LLM_SERVICE_API_KEY=changeme

# SAM v2 offline artifacts (local paths, not checked in).
# SAM_CHART_PATH: unpacked Helm chart directory (contains Chart.yaml).
# SAM_*_IMAGE_TAR: offline image tarballs for scripts/load-images.sh.
SAM_CHART_PATH=/path/to/solace-agent-mesh
SAM_APP_IMAGE_TAR=/path/to/solace-agent-mesh-2.225.14-app-arm64.tar.gz
SAM_STR_IMAGE_TAR=/path/to/solace-agent-mesh-1.50.3-str-arm64.tar.gz

# sam CLI (used by scripts/rbac, scripts/agents, scripts/models):
# either an extracted binary (SAM_CLI_PATH) or the delivery-package
# tarball (SAM_CLI_TAR, auto-extracted to scripts/lib/.cache/).
SAM_CLI_PATH=/path/to/sam
SAM_CLI_TAR=/path/to/solace-agent-mesh-2.225.14-cli-darwin-arm64.tar.gz

# Retail demo DB credentials for scripts/agents connectors
# (optional; defaults to postgres/postgres from the manifest).
#RETAIL_DB_USERNAME=postgres
#RETAIL_DB_PASSWORD=postgres
