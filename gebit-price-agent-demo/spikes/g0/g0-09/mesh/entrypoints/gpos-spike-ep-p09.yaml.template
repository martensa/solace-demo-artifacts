  deploy: true
  values:
    broker_url: "ws://host.docker.internal:8008"
    broker_vpn: "default"
    broker_username: "__BROKER_USERNAME__"
    broker_password: "__BROKER_PASSWORD__"
    tls_skip_verify: "false"
    event_rules:
      - name: write
        subscriptions:
          - topic: "gpos/spike/p09/write/>"
            qos: 1
        messageFormat: json
        targetWorkflowName: gpos-spike-p09-write
        inputExpression: "input.payload:"
        defaultUserIdentity: marktleitung@solace.lab
        acknowledgmentPolicy:
          mode: on_receive
        successOutput:
          enabled: true
          topic: "gpos/spike/p09/out/ok"
          topicType: static
          responseType: structured
        errorOutput:
          enabled: true
          topic: "gpos/spike/p09/out/err"
          topicType: static
          responseType: error
      - name: b1
