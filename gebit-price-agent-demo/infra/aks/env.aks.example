# Template of gebit-price-agent-demo/.env.aks: the settings of the gpos demo
# scripts for TARGET=aks (runbook AKS-MIGRATION-PLAN.md 1.3). Copy it with
#   (umask 077; cp gebit-price-agent-demo/infra/aks/env.aks.example \
#     gebit-price-agent-demo/.env.aks)
# The copy is git-ignored (.env.*), mode 600, never in git, chats or backups.
# The file name of this template has no leading dot, so .env.* does not hide it.
#
# No password or token in this file, ever: the scripts read secrets at
# runtime from the Key Vault (the *_KV keys name vault secrets). The LLM key
# lives only in agent-mesh-deployment/.env.aks and in SAM. The one exception
# is the optional ZeroSSL ACME_EAB_HMAC below: only zerossl_on reads it, and
# the gpos scripts drop it right after loading this file (never exported).
# With TARGET=aks the scripts read this file only, never .env. One key per
# line. The gpos scripts source it with the shell (set -a; . file), so a value
# with spaces needs double quotes. aks.sh reads AKS_ACR, AKS_KV and the
# commented fallbacks without a shell: it strips surrounding quotes but does
# not expand $VARS, so give those keys literal values. It also reads SAM_HOME
# (expanding only a leading $HOME) and SAM_URL, to compare them with its own.

# Azure names, globally unique; the owner fills in these two
AKS_ACR=
AKS_KV=
# Fallbacks of aks_tags, only if the resource group gebit-showcase returns no
# tags: the Owner tag value and the Created Date (dd.mm.yyyy). The Owner value
# usually has a space: write it in double quotes, OWNER_TAG="Given Family"
# OWNER_TAG=
# CREATED_DATE=
# ZeroSSL fallback only (runbook 4.3, zerossl_on): EAB key id and HMAC key of
# the ZeroSSL account; never in git or the Key Vault
# ACME_EAB_KID=
# ACME_EAB_HMAC=
# Grafana under https://<FQDN>/grafana/ (runbook A11, grafana_allow): extra
# public IPs or CIDRs for the allowlist, comma separated without blanks (the
# TARGET=aks scripts source this file with bash); the caller's own IP is
# always added. Never a booth or 5G IP (shared NAT/CGNAT). Personal IPs: this
# file only, never in git
# GRAFANA_ALLOW=

# Demo image in the ACR above; 0.1.4 from runbook A20
GPOS_NS=gpos-demo
GPOS_IMAGE=${AKS_ACR}.azurecr.io/gpos-demo/gpos-demo
GPOS_VERSION=0.1.3
# SAM on the public name. SAM_HOME is the HOME the sam CLI runs with for AKS
# (sam 2.542.1 ignores SAM_HOME for its login cache, so aks_sam and the
# TARGET=aks scripts set HOME); the AKS login cache is then
# $SAM_HOME/Library/Application Support/sam/auth/solace-lab.json. aks_sam has
# both values built in (AKS_SAM_HOME, https://$FQDN) and refuses to run when
# SAM_HOME or SAM_URL here differ, so keep these two lines as they are.
SAM_URL=https://eurocis-showcase.germanywestcentral.cloudapp.azure.com
SAM_RUN_IDENTITY=marktleitung@solace.lab
SAM_HOME=$HOME/.config/eurocis-aks/sam
# Optional sam CLI binary (else `sam` on the PATH); when set, keep it equal to
# SAM_CLI_PATH of agent-mesh-deployment/.env.aks, which aks_sam uses, so the
# A17 login and the gpd scripts run the same CLI build
# SAM_CLI_PATH=
# Cluster access: admin kubeconfig file and its context (never ~/.kube/config)
AKS_KUBECONFIG=$HOME/.kube/aks-eurocis.yaml
KUBE_CONTEXT=aks-eurocis-admin
# Broker solace-pubsubplus in the cluster (pods only), VPN default, client
# username gpos; its password is the vault secret named here
BROKER_SMF_URL=tcp://solace-pubsubplus.solace.svc.cluster.local:55555
BROKER_WS_URL=ws://solace-pubsubplus.solace.svc.cluster.local:8008
BROKER_VPN=default
BROKER_USERNAME=gpos
BROKER_PASSWORD_KV=solace-gpos
# SEMP only through the port-forward 127.0.0.1:18080 (Mac port 8080 is the
# lab broker); admin password from the vault secret named here
SEMP_URL=http://127.0.0.1:18080
SEMP_USER=admin
SEMP_PASSWORD_KV=solace-admin
# R1 mode: switching needs scripts/broker.sh r1-switch (rule 4)
R1_MODE=own
R1_QUEUE=gpos-booth-r1
GPOS_DELIVERY=direct
# Demo database: StatefulSet gpos-postgres in gpos-data, psql as postgres via
# kubectl exec over the local socket (no password needed)
PG_MODE=kubectl
PG_NS=gpos-data
PG_POD=gpos-postgres-0
PG_HOST_FROM_PODS=gpos-postgres.gpos-data.svc.cluster.local
PG_PORT=5432
PG_DB=gpos
# GEBIT vendor descriptor sets: read at runtime only, never copied
GEBIT_DESCRIPTOR_DIR=$HOME/Downloads/Gebit
# Demo
GPOS_DEMO_DATE=2027-02-16
GPOS_BOOTH_LOCATION=Root.DE.999.101.01
GPOS_TEST_LOCATION=Root.DE.999.199.99
GPOS_PROBE_LOCATION=Root.DE.999.199.98
GATE_MIN_DELAY_S=3
# block (default) | warn (diagnosis) | f2 (fallback F2)
GATE_GUARD=block
# e2e and inbox watcher (Mac): public BFF URL; "system" = system trust store
# (Let's Encrypt), no lab CA
E2E_BASE_URL=https://eurocis-showcase.germanywestcentral.cloudapp.azure.com
E2E_CA_FILE=system
# awe logs for e2e (kubectl logs through the AKS kubeconfig and context)
AWE_NS=sam-solace-lab
AWE_DEPLOY=agent-mesh-solace-agent-mesh-awe
