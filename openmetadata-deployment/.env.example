# OpenMetadata deployment - environment template.
#
# Copy to .env and fill in the values. start.sh sources this file and
# refuses to deploy if KEYCLOAK_CLIENT_SECRET is still the placeholder.

# --- Keycloak admin (used by setup-keycloak-client.sh) ---------------------
# Bootstraps the OIDC client in the solace-lab realm using the realm
# admin account. Realm admin (admin / admin@solace.lab) is provisioned
# by solace-lab-infrastructure.
KEYCLOAK_URL=https://auth.solace.lab
KEYCLOAK_REALM=solace-lab
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- Keycloak OIDC client (populated by setup-keycloak-client.sh) ---------
# Run scripts/setup-keycloak-client.sh, then paste the printed secret.
KEYCLOAK_CLIENT_ID=openmetadata
KEYCLOAK_CLIENT_SECRET=changeme
KEYCLOAK_ISSUER=https://auth.solace.lab/realms/solace-lab

# --- Solace Event Portal connector (used later, not by start.sh) ----------
SOLACE_EVENTPORTAL_TOKEN=changeme

# --- OM ingestion bot JWT (fetch from UI: Settings -> Bots -> ingestion-bot)
OM_INGESTION_BOT_TOKEN=changeme
