# OpenMetadata deployment - environment template.
#
# This MVP deployment does not require any secrets via .env: passwords
# in local-k8s-deps-values.yaml are demo-only and re-used between the
# two charts, and the JWT keypair is generated locally by
# scripts/setup-rsa-keys.sh.
#
# This file exists so that you have a place to drop OM-related values
# (e.g. an Event Portal API token used by the ingestion workflow) when
# you start running the Solace connector against this OM instance.
# start.sh does not currently read these.

# --- Solace Event Portal connector (used later, not by start.sh) -----------
SOLACE_EVENTPORTAL_TOKEN=changeme

# --- OM ingestion bot JWT (fetch from UI: Settings -> Bots -> ingestion-bot)
OM_INGESTION_BOT_TOKEN=changeme
