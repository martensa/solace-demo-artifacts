# Copy to .env (git-ignored) and fill in. install.sh turns the broker
# values into the Kubernetes Secret bsg-demo/bsg-broker; nothing else
# reads .env at runtime.

# Client username/password on the sam VPN of solace-1 (the VPN SAM
# itself uses). MQTT plain text port 1883 (docker-compose mapping of
# event-mesh-deployment).
MQTT_USERNAME=default
MQTT_PASSWORD=change-me

# Credentials the SAM event-mesh entrypoint uses for the same VPN
# (default: the MQTT values above).
# SAM_BROKER_USERNAME=
# SAM_BROKER_PASSWORD=

# Entrypoint -> workflow target: "runtime" (workaround, default) or
# "name" once Gate 0 shows the 2.348.22 bug is fixed in 2.493.0.
# ENTRYPOINT_WORKFLOW_TARGET=runtime

# sam CLI (see ../agent-mesh-deployment/.env.example)
# SAM_CLI_PATH=/usr/local/bin/sam
