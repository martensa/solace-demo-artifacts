# Copy to .env (git-ignored) and fill in. install.sh turns the broker
# values into the Kubernetes Secret bsg-demo/bsg-broker; nothing else
# reads .env at runtime.

# Client username/password on the `default` VPN of solace-1. MQTT plain
# text port 1883 belongs to that VPN -- the `sam` VPN has every MQTT
# listener disabled (Gate 0, decision A), so the demo's feed lives on
# `default` and the SAM entrypoint reads it there.
MQTT_USERNAME=default
MQTT_PASSWORD=change-me

# Credentials and VPN the SAM event-mesh entrypoint uses (defaults: the
# MQTT values above and the `default` VPN).
# SAM_BROKER_USERNAME=
# SAM_BROKER_PASSWORD=
# SAM_BROKER_VPN=default

# Entrypoint -> workflow target: "name" (2.493.0 and 2.542.1 resolve
# the friendly name, the default) or "runtime" for the 2.348.22
# workaround.
# ENTRYPOINT_WORKFLOW_TARGET=name

# sam CLI (see ../agent-mesh-deployment/.env.example)
# SAM_CLI_PATH=/usr/local/bin/sam
