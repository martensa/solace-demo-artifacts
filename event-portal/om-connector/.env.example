# Connector deployment config. Copy to .env and fill in:
#   cp .env.example .env
# In the lab, only EP_API_TOKEN is strictly required -- the OM ingestion-bot
# JWT is fetched automatically from Keycloak. .env is gitignored.

# --- Event Portal (required) -----------------------------------------------
# Reader token: EP -> My Account -> Token Management.
EP_API_TOKEN=
# EP REST base URL (default fine for Solace Cloud).
EP_API_URL=https://api.solace.cloud/api/v2
# Optional: restrict to specific EP application domains (OM FilterPattern JSON).
# Unset = every domain the token can see. Example:
#   EP_DOMAIN_FILTER={"includes": ["^aldi-orders-demo$"], "excludes": [".*-test$"]}
EP_DOMAIN_FILTER=

# --- OpenMetadata target ----------------------------------------------------
# In-cluster address of the EXISTING OM (the connector workloads use this).
OM_HOST_PORT=http://openmetadata.openmetadata-solace-lab.svc.cluster.local:8585/api
# Provide the ingestion-bot JWT directly to SKIP the Keycloak auto-fetch
# (needed for a non-lab OM with no Keycloak access). Leave empty in the lab.
OM_JWT_TOKEN=

# --- Deployment targets (defaults shown) ------------------------------------
CONNECTOR_NAMESPACE=openmetadata-solace-connector
CONNECTOR_RELEASE=solace-eventportal-connector
PULL_SECRET_SRC_NS=openmetadata-solace-lab

# --- Keycloak bot-JWT auto-fetch (lab only) ---------------------------------
# get-om-bot-token.sh sources openmetadata-deployment/.env for the OM OIDC
# client id + secret automatically. Override the realm admin only if different:
# OM_ADMIN_USER=admin
# OM_ADMIN_PASSWORD=admin
# OM_PUBLIC_URL=https://openmetadata.solace.lab
