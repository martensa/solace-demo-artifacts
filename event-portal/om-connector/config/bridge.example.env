# Sample env-file for the bridge. Copy to .env and fill in secrets.

# --- Event Portal ----------------------------------------------------------
EP_API_URL=https://api.solace.cloud/api/v2
EP_API_TOKEN=                          # required: same scope as connector
EP_WEBHOOK_SECRET=                     # required: shared with EP webhook sub

# --- OpenMetadata ----------------------------------------------------------
OM_HOST_PORT=http://openmetadata-server:8585/api
OM_JWT_TOKEN=                          # ingestion-bot JWT
OM_SERVICE_NAME=solace-event-portal   # must match the MessagingService name

# --- Transport -------------------------------------------------------------
BRIDGE_MODE=http                       # http | solace | forwarder
BRIDGE_BIND_HOST=0.0.0.0
BRIDGE_BIND_PORT=8080

# Solace transport (used by BRIDGE_MODE=solace as consumer
# and by BRIDGE_MODE=forwarder as publisher)
BRIDGE_SOLACE_HOST=tcp://solace_1:55555
BRIDGE_SOLACE_VPN=default
BRIDGE_SOLACE_USERNAME=om-bridge
BRIDGE_SOLACE_PASSWORD=
BRIDGE_SOLACE_QUEUE=om/sync/eventportal

# Forwarder
BRIDGE_FORWARDER_TOPIC_PREFIX=om/sync/eventportal

# Dedupe + filter
BRIDGE_DEDUPE_TTL_SECONDS=600
BRIDGE_DEDUPE_MAX_ENTRIES=10000
# BRIDGE_ACCEPT_EVENT_TYPES=event.updated,eventVersion.updated
