# Standalone container for the Event Portal -> OpenMetadata bridge.
#
# The bridge applies governance changes back to OM (handlers.py builds OM
# entities), so it REQUIRES the OpenMetadata SDK (`metadata` package) at
# runtime. It therefore bases on the OM ingestion image -- the same SDK the
# connector + ingestion CronJob use -- and adds the bridge runtime extras
# (FastAPI receiver, Prometheus metrics, OpenTelemetry tracing). A plain
# python:slim base is NOT enough: bridge/handlers.py imports
# metadata.generated.schema... at module load and would ModuleNotFoundError.
#
# Build (lab): ./scripts/build-bridge-image.sh   (passes OM_INGESTION_VERSION)
# Build (manual):
#   docker build -f Dockerfile.bridge \
#     --build-arg OM_INGESTION_VERSION=1.13.0 \
#     -t registry.solace.lab/om-eventportal-bridge:0.9.0 .
#
# OM_INGESTION_VERSION must match the OM server version (same SDK).
ARG OM_INGESTION_VERSION=1.13.0
FROM docker.getcollate.io/openmetadata/ingestion:${OM_INGESTION_VERSION}

# The Collate base guards against root-side pip installs and expects the
# `airflow` user (UID 50000). Mirror the connector ingestion Dockerfile.
USER airflow
WORKDIR /home/airflow/bridge-build

COPY --chown=airflow:airflow pyproject.toml ./
COPY --chown=airflow:airflow connector ./connector
COPY --chown=airflow:airflow bridge ./bridge

# Installs the connector + bridge packages with the bridge runtime extras.
# The OM SDK is already provided by the base image.
RUN pip install --no-cache-dir ".[bridge,bridge-solace,otel]"

# Smoke test: the bridge entrypoint imports cleanly WITH the OM SDK present
# (catches the missing-SDK regression at build time, not at pod start).
RUN python -c "import bridge.main; \
               from metadata.generated.schema.entity.data.topic import Topic; \
               print('bridge import OK')"

# 8080: HTTP/forwarder webhook receiver. 9100: Prometheus /metrics in
# polling/solace mode (BRIDGE_OBS_METRICS_ENABLED=true). See bridge/config.py.
EXPOSE 8080 9100

ENTRYPOINT ["python", "-m", "bridge.main"]
