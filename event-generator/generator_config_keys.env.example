# Event generator configuration -- copy to generator_config_keys.env
# and replace the token placeholder:
#   cp generator_config_keys.env.example generator_config_keys.env
#
# EVENT_PORTAL_TOKEN is a real Solace Cloud API token and must NEVER
# be committed (generator_config_keys.env is gitignored). All other
# values are local demo settings: the MEM runtime credentials
# "Acme Retail On-Prem" resolve to the local event mesh brokers,
# and default/default is the intentionally checked-in demo user
# (see the repo secrets conventions).
EVENT_PORTAL_TOKEN=changeme
EVENT_PORTAL_APPLICATION_DOMAIN_NAME=Acme Retail - Master Data Management
EVENT_PORTAL_EVENT_API_PRODUCT_NAME=SAP Event API Product
EVENT_PORTAL_EVENT_API_PRODUCT_VERSION=0.1.0
EVENT_PORTAL_PLAN_NAME=Guaranteed SAP Events
EVENT_PORTAL_MEM_RUNTIME_EVENT_BROKER_CREDENTIALS_NAME=Acme Retail On-Prem
EVENT_PORTAL_MEM_RUNTIME_EVENT_BROKER_CREDENTIALS_USERNAME=default
EVENT_PORTAL_MEM_RUNTIME_EVENT_BROKER_CREDENTIALS_PASSWORD=default
