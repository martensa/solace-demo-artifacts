# =============================================================================
# Secret: topic-compaction-mi-secret  (template)
# Real values come from environment variables when start.sh renders this
# template via envsubst. The rendered file is gitignored.
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: topic-compaction-mi-secret
  namespace: mi-solace-lab
  labels:
    app.kubernetes.io/name: topic-compaction-mi
    app.kubernetes.io/component: secret
type: Opaque
stringData:
  # ---- Solace broker (Solace Cloud per ADR 0001) ---------------------------
  SOLACE_HOST: "${SOLACE_HOST}"
  SOLACE_VPN: "${SOLACE_VPN}"
  SOLACE_USERNAME: "${SOLACE_USERNAME}"
  SOLACE_PASSWORD: "${SOLACE_PASSWORD}"

  # ---- REST authentication (Phase 4.1) -------------------------------------
  MI_USER_NAME: "${MI_USER_NAME}"
  MI_USER_PASSWORD: "${MI_USER_PASSWORD}"
  MI_ADMIN_NAME: "${MI_ADMIN_NAME}"
  MI_ADMIN_PASSWORD: "${MI_ADMIN_PASSWORD}"

  # ---- SEMP auto-provisioning (Phase 4.2) - optional -----------------------
  # When MI_PROVISIONING_ENABLED=true the MI runs an idempotent
  # ApplicationRunner on startup that creates the three workflow
  # queues + subscriptions via SEMP. Use admin-level credentials
  # (e.g. mission-control-manager on Solace Cloud), NOT the
  # messaging client. When disabled, the SEMP_* values can be empty.
  MI_PROVISIONING_ENABLED: "${MI_PROVISIONING_ENABLED}"
  SEMP_URL: "${SEMP_URL}"
  SEMP_USER: "${SEMP_USER}"
  SEMP_PASS: "${SEMP_PASS}"
