# =============================================================================
# Topic Compaction MI - environment configuration
# =============================================================================
# This file is COMMITTED with placeholder values.
# Copy it to .env (which is gitignored) and fill in your real broker
# credentials there.
#
#   cp .env.example .env
#   $EDITOR .env
#   make up
# =============================================================================

# -----------------------------------------------------------------------------
# Pick ONE preset below by uncommenting the block, or define your own values.
# Both presets assume PLAIN (non-TLS) SMF. If your broker enforces TLS, switch
# the scheme to tcps:// and use port 55443.
# -----------------------------------------------------------------------------

# --- Preset A: Solace Cloud ---
# Find these in your Solace Cloud Service -> Connect -> Solace Messaging API
# for Java -> SMF Host (and corresponding REST Messaging endpoint).
SOLACE_HOST=tcp://mr-connection-XXXXXXXX.messaging.solace.cloud:55555
SOLACE_VPN=your-vpn-name
SOLACE_USERNAME=solace-cloud-client
SOLACE_PASSWORD=replace-me

# REST endpoint for publishing test messages from the host (smoke tests, curl).
SOLACE_REST_HOST=http://mr-connection-XXXXXXXX.messaging.solace.cloud:9000
SOLACE_REST_USER=solace-cloud-client
SOLACE_REST_PASS=replace-me

# --- Preset B: Local agent-mesh-deployment broker (sam-solace-lab) ---
# Uncomment and adjust to point at the Solace broker that comes with the
# solace-demo-artifacts agent-mesh-deployment helm chart.
#
# SOLACE_HOST=tcp://host.docker.internal:55554
# SOLACE_VPN=default
# SOLACE_USERNAME=default
# SOLACE_PASSWORD=default
# SOLACE_REST_HOST=http://host.docker.internal:9000
# SOLACE_REST_USER=default
# SOLACE_REST_PASS=default

# -----------------------------------------------------------------------------
# MI runtime
# -----------------------------------------------------------------------------

# Host port where the MI exposes REST + actuator. Container side is 8090.
MI_PORT=18090

# Container image tag - bump when releasing.
MI_IMAGE=registry.solace.lab/sam-topic-compaction-mi:1.0.0

# -----------------------------------------------------------------------------
# REST + Actuator authentication (Phase 4 / V1.0)
# -----------------------------------------------------------------------------
# Disabled by default for the docker-compose dev mode. Flip to true
# and set fresh passwords below to exercise the role matrix locally.
# In Kubernetes the overlay sets MI_SECURITY_ENABLED=true and reads
# the credentials from a Secret.
MI_SECURITY_ENABLED=false

# mi-user can read from /api/v1/kv (GET, list).
MI_USER_NAME=mi-user
MI_USER_PASSWORD=change-me-user

# mi-admin can do everything mi-user can, plus DELETE on
# /api/v1/kv/... and the /api/v1/admin/* endpoints (backup/restore).
MI_ADMIN_NAME=mi-admin
MI_ADMIN_PASSWORD=change-me-admin
