# DB Designer deploy-time secret overrides (all optional).
#
# Copy to .env and set any you want to override; scripts/start.sh injects
# them via `helm --set`. Every value here is a DEMO default already baked
# into the chart, so an empty/absent .env still yields a working local
# deployment. Never put real production secrets in a committed file.

# Bundled Postgres metadata DB
POSTGRES_PASSWORD=postgres

# Solace broker credentials the Designer/meta-api use
SOLACE_CLIENT_PASSWORD=coeadmin
SOLACE_MGMT_PASSWORD=coeadmin
SOLACE_API_TOKEN=

# Backend app secrets
SECRET_APP_KEY=TEST
SECRET_REFRESH_KEY=TEST1
PASSWORD_ENCRYPTION_KEY=solace
ADMIN_USER_PASSWORD=admin
